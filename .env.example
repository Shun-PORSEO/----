# ---- AI（未設定ならデモモード＝固定応答で動きます） ----
ANTHROPIC_API_KEY=
# 使用モデル（既定: claude-opus-5）
CLAUDE_MODEL=claude-opus-5
# 拒否応答時のサーバー側フォールバック（off で無効）
CLAUDE_FALLBACKS=on

# ---- 会員（試行ユーザー）: "コード:会社名" をカンマ区切り ----
# コードは推測されにくいランダム文字列に（例: openssl rand -hex 8）
MEMBER_CODES=
# 1会員あたりの1時間の上限回数
RATE_LIMIT_PER_HOUR=120

# ---- 画面に出すリンク ----
SERVICE_NAME=会社の記憶帳
OPERATOR_NAME=PORSEO
CONTACT_EMAIL=
# お悩み相談フォーム（Google Forms / Microsoft Forms）
CONSULT_FORM_URL=
# 試行ユーザー申し込みフォーム（未設定なら CONTACT_EMAIL 宛てのメール）
TRIAL_FORM_URL=
# メルマガ登録ページ、ポッドキャスト
NEWSLETTER_URL=
PODCAST_URL=

PORT=8787
